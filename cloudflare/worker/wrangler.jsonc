{
  "name": "silverdice",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "SESSION_TTL_SECONDS": "86400"
  },
  "secrets": {
    "required": [
      "SILVERDICE_URL",
      "SILVERDICE_AUTH_TOKEN",
      "SESSION_SIGNING_SECRET"
    ]
  }
}
